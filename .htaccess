Options -Indexes

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^api/?$ backend.php?route=/health [L,QSA]
  RewriteRule ^api/(.*)$ backend.php?route=/$1 [L,QSA]
  RewriteRule ^uploads/([a-f0-9]{32}\.jpg)$ backend.php?route=/uploads/$1 [L,QSA]
  RewriteRule ^(de|en)/?$ index.html [L]
  RewriteRule ^de/(lernen|assistent|artikel(?:/[^/]+)?|ueber-uns|kontakt|publizieren|impressum|datenschutz)/?$ index.html [L]
  RewriteRule ^en/(learn|assistant|articles(?:/[^/]+)?|about|contact|publish|imprint|privacy)/?$ index.html [L]
  RewriteRule ^\.git/ - [F,L]
  RewriteRule ^data/ - [F,L]
  RewriteRule ^(server\.js|package\.json|package-lock\.json|Dockerfile|\.dockerignore|\.gitignore)$ - [F,L]
</IfModule>

<FilesMatch "^(server\.js|package\.json|package-lock\.json|README\.md|Dockerfile|\.dockerignore|\.gitignore)$">
  Require all denied
</FilesMatch>
