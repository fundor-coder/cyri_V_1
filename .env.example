# Never commit real secrets. Copy this file to .env on the server.
CYRI_PUBLISH_PASSWORD=
CYRI_PUBLISH_PASSWORD_HASH=
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.4-mini

# Contact email delivery through Resend.
# Verify send.cyri.online in Resend before using this sender.
RESEND_API_KEY=
CYRI_CONTACT_FROM=CYRI Website <website@send.cyri.online>
CYRI_CONTACT_TO=climateyri@gmail.com

# Enable only when the app runs behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Leave false when the Node/PHP server is directly exposed.
CYRI_TRUST_PROXY=false
